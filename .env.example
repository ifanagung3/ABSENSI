APP_NAME="Hadirin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://absensi.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hadirin.test"
MAIL_FROM_NAME="${APP_NAME}"

# Pengaturan absensi
ATTENDANCE_SCHOOL_NAME="SMKN 4 Pariaman"
ATTENDANCE_ENFORCE_TIME_WINDOW=true
ATTENDANCE_MAX_CLOCK_SKEW_MINUTES=10
ATTENDANCE_DUPLICATE_PHOTO_REVIEW=true
ATTENDANCE_PHOTO_MAX_KB=4096
ATTENDANCE_CHECKOUT_GRACE_HOURS=12
ATTENDANCE_MAX_BULK_SCHEDULE_DAYS=366
ATTENDANCE_MAX_BULK_EMPLOYEES=500
ATTENDANCE_MAX_LEAVE_DAYS=366
